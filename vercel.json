{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/health" },
    { "src": "/analyze", "dest": "/api/analyze" },
    { "src": "/metrics", "dest": "/api/metrics" }
  ]
}
